{
  "appId": "com.gsneves.incursionx3battle",
  "appName": "INCURSION",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "cleartext": false,
    "allowNavigation": ["incursion-servidor.onrender.com"]
  },
  "backgroundColor": "#03050B",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "backgroundColor": "#03050B",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK",
      "backgroundColor": "#00000000"
    }
  }
}
